# Copy to .env and adjust. Everything has a sensible default, so this file is optional.

# --- Local LLM (Ollama) ---
OLLAMA_HOST=http://localhost:11434
# Needs tool-calling support. Good small options: llama3.2 (3B), qwen2.5:3b, qwen2.5:7b, llama3.1:8b
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120

# --- API / UI ---
MLHUB_API_URL=http://localhost:8000
# If set, every /v1 request must send the header X-API-Key: <value> (the UI does this automatically)
MLHUB_API_KEY=

# --- Training ---
# Where models/, data/, logs/, reports/ and mlflow.db live (default: current directory)
# MLHUB_HOME=.
# 1 = never download datasets, use small synthetic stand-ins (spam, house); handy for CI
MLHUB_OFFLINE=0
# 0 = skip MLflow tracking
MLHUB_MLFLOW=1
